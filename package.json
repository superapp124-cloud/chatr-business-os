  "build": {
    "appId": "chat.chatr.desktop",
    "productName": "CHATR Desktop",
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chatr-workspace",
        "repo": "chatr-desktop"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "include": "electron/installer.nsh"
    },
    "protocols": {
      "name": "chatr-deep-link",
      "schemes": [
        "chatr"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
