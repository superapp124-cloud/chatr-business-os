{
  "name": "chatr-desktop",
  "private": true,
  "version": "0.9.0-rc",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite -c vite.desktop.config.ts --mode desktop",
    "dev:android": "vite -c vite.mobile.config.ts --mode mobile",
    "android:live": "node scripts/android-live.cjs",
    "kill:port": "node -e \"const { execSync } = require('child_process'); try { const r = execSync('netstat -ano').toString(); const lines = r.split('\\n').filter(l => l.includes(':8086') && l.includes('LISTENING')); lines.forEach(l => { const pid = l.trim().split(/\\s+/).pop(); if (pid && /^\\d+$/.test(pid)) { try { execSync('taskkill /PID ' + pid + ' /F'); console.log('Killed PID ' + pid); } catch(e){} } }); } catch(e) { console.log('No process on 8086'); }\"",
    "kill:electron": "node -e \"const { execSync } = require('child_process'); try { execSync('taskkill /IM electron.exe /F'); console.log('Killed electron.exe'); } catch(e) { console.log('No electron process'); }\"",
    "dev:fresh": "npm run kill:electron && npm run kill:port && npm run electron:dev",
    "electron:dev": "cross-env NODE_ENV=development concurrently \"npm run dev:desktop\" \"wait-on http://localhost:8086 && electron .\"",
    "electron:build": "npm run build:desktop && electron-builder",
    "start:desktop": "cross-env NODE_ENV=production electron .",
    "build": "vite build",
    "build:desktop": "vite build -c vite.desktop.config.ts --mode desktop",
    "build:mobile": "vite build -c vite.mobile.config.ts --mode mobile",
    "build:dev": "vite build --mode development",
    "search:server": "tsx watch server/src/server.ts",
    "readiness": "tsx src/scripts/readiness.ts",
    "certify:business-os": "node scripts/business-os-certification.cjs",
    "lint": "npm run lint:architecture && npm run lint:governance",
    "lint:architecture": "node scripts/architecture-lint.cjs",
    "lint:architecture:update-baseline": "node scripts/architecture-lint.cjs --update-baseline",
    "lint:governance": "node scripts/lint-governance.cjs",
    "validate:event-schema": "node scripts/event-schema-validation.cjs",
    "lint:raw": "eslint src supabase/functions scripts --ext .ts,.tsx,.js,.cjs",
    "lint:update-baseline": "node scripts/lint-governance.cjs --update-baseline",
    "signaling:validate": "node scripts/validate-signaling-config.cjs",
    "edge:functions:audit": "node scripts/edge-function-governance.cjs",
    "edge:functions:update-baseline": "node scripts/edge-function-governance.cjs --update-baseline",
    "preview": "vite preview",
    "postinstall": "node scripts/download-whisper.js"
  },
