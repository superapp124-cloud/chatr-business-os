{
  "name": "chatr-backend-realtime",
  "version": "2.0.0",
  "description": "CHATR real-time backend — Socket.IO + Redis + JWT",
  "main": "server-enhanced.js",
  "scripts": {
    "start": "node server-enhanced.js",
    "start:prod": "node start-production.js",
    "start:pm2": "pm2 start ecosystem.config.js --env production",
