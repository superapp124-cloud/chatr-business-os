# ─── CHATR Real-Time Backend — Environment Variables ───────────────────────
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# CORS allowed origin (comma-separated, or * for all)
# Example: http://localhost:5173,https://yourapp.vercel.app
CORS_ORIGIN=*

# ── Redis (Optional — Upstash recommended) ──────────────────────────────────
#
# Leave empty for single-node mode (suitable for dev and low-traffic prod).
# For horizontal scaling: provide an Upstash Redis REST URL or a standard
# Redis connection string.
#
# Upstash format:  rediss://default:<password>@<host>.upstash.io:6379
# Local format:    redis://localhost:6379
REDIS_URL=

# ── Authentication ───────────────────────────────────────────────────────────
#
# Found in: Supabase Dashboard → Project Settings → API → JWT Secret
# Required for production. In dev mode (no secret set), userId must be
# passed directly in socket.handshake.auth.userId.
SUPABASE_JWT_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
NODE_ENV=development
