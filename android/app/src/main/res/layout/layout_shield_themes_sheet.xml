<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_shield_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_shield_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Themes"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />
        
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Apply a color tint to your call."
        android:textColor="@color/shield_text_secondary"
        android:textSize="14sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:scrollbars="none">
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            
            <Button android:id="@+id/btnThemeCosmic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cosmic" android:backgroundTint="#6200EA" android:textColor="@color/white" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnThemeAurora" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aurora" android:backgroundTint="#00C853" android:textColor="@color/white" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnThemeMidnight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Midnight" android:backgroundTint="#000000" android:textColor="@color/white" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnThemeOcean" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ocean" android:backgroundTint="#2962FF" android:textColor="@color/white" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnThemeForest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Forest" android:backgroundTint="#1B5E20" android:textColor="@color/white" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnThemeSunset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sunset" android:backgroundTint="#FF6D00" android:textColor="@color/white" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnThemeRoyal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Royal" android:backgroundTint="#D50000" android:textColor="@color/white" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnThemeNone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="None" android:backgroundTint="#333333" android:textColor="@color/shield_text_secondary" android:layout_marginEnd="8dp"/>
            
        </LinearLayout>
    </HorizontalScrollView>
    
</LinearLayout>
