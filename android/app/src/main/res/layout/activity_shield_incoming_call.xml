<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shield_bg">

    <!-- Blurred background avatar -->
    <ImageView
        android:id="@+id/backgroundBlurImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top spacer for status bar -->
    <Space
        android:id="@+id/topSpacer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Shield Header -->
    <LinearLayout
        android:id="@+id/shieldHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_shield_pulse_ring"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/topSpacer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_shield_check"
            app:tint="@color/shield_accept_start"
            tools:ignore="MissingPrefix" />
            
        <TextView
            android:id="@+id/shieldTrustBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Shield AI Protected"
            android:textColor="@color/shield_accept_start"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Caller Avatar -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/shieldHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <View
            android:id="@+id/pulseRing1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_shield_pulse_ring" />
            
        <View
            android:id="@+id/pulseRing2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_shield_pulse_ring" />

        <ImageView
            android:id="@+id/callerAvatarImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_shield_pulse_ring"
            android:scaleType="centerCrop" />
            
        <TextView
            android:id="@+id/callerInitialText"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/shield_text_primary"
            android:textSize="48sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Caller Details -->
    <TextView
        android:id="@+id/callerNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:text="Unknown Caller"
        android:textColor="@color/shield_text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/avatarContainer" />

    <TextView
        android:id="@+id/callerPhoneText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Incoming Call"
        android:textColor="@color/shield_text_secondary"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/callerNameText" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="64dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/btnDecline"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_shield_pulse_ring"
            android:backgroundTint="@color/shield_decline"
            android:gravity="center"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_call_end"
                app:tint="@color/shield_text_primary" />
        </LinearLayout>

        <Space
            android:layout_width="48dp"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/btnAnswer"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_shield_pulse_ring"
            android:backgroundTint="@color/shield_accept_start"
            android:gravity="center"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_call"
                app:tint="@color/shield_text_primary" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
