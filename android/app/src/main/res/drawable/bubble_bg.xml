<?xml version="1.0" encoding="utf-8"?>
<!-- Circular gradient background for the AI bubble -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="50%"
        android:startColor="#8B5CF6"
        android:endColor="#6366F1"/>
    <stroke
        android:width="1.5dp"
        android:color="#A78BFA"/>
</shape>
